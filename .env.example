# Local configuration for chora-payments.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
POSTGRES_DB=chora_payments
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@postgres:5432/chora_payments?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-payments-local

# Event bus — NATS JetStream. Unset disables the bus (outbox degrades to
# NoOpEmitter; SSE /stream returns 503).
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# Project label stamped into every event envelope's source_project.
CHORA_SOURCE_PROJECT=chora-local

# Stripe. Unset STRIPE_API_KEY selects the stub adapter (local-dev only).
STRIPE_API_KEY=
STRIPE_TEST_MODE=true
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_SUCCESS_URL=https://chora.site/payment/success
STRIPE_DEFAULT_CANCEL_URL=https://chora.site/payment/cancel

# Stripe Price catalogue (CHO-1760). Env-backed secret name holding the
# (addon:tier:currency → price_id) JSON blob. Unset → placeholder catalogue
# (Subscribe + change-tier refuse on placeholder Price IDs).
STRIPE_PRICE_CATALOGUE_SECRET_ID=

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
